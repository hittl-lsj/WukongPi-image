/dts-v1/;

#include "sun8i-h3.dtsi"
#include "sunxi-common-regulators.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "WuKong Pi H3";
	compatible = "wukong,wukongpi-h3", "allwinner,sun8i-h3";

	aliases {
		serial0 = &uart0;
		ethernet0 = &emac;
		ethernet1 = &xr819;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&red_led_pins>;
		power-led {
			label = "wukongpi:green:power";
			gpios = <&r_pio 0 10 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		status-led {
			status = "disabled";
			label = "wukongpi:red:status";
			gpios = <&pio 0 17 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
	key{
		compatible = "wukongpi,key";
		pinctrl-names = "default";
		pinctrl-0 = <&key_pa6_pins>;
		gpios = <&pio 0 6 GPIO_ACTIVE_LOW>;

		interrupt-parent = <&pio>;
		interrupts = < 0 6 IRQ_TYPE_EDGE_BOTH>;


		status = "okay";
	};
	reg_vdd_cpux: vdd-cpux-regulator {
		compatible = "regulator-gpio";
		regulator-name = "vdd-cpux";
		regulator-type = "voltage";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1300000>;
		regulator-ramp-delay = <50>;

		gpios = <&r_pio 0 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		gpios-states = <1>;
		states = <1100000 0>, <1300000 1>;
	};
		reg_vcc_wifi: reg-vcc-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 0 20 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 0 7 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};
	
};

&cpu0 {
	cpu-supply = <&reg_vdd_cpux>;
};

&mmc0 {
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pa_pins>;
	status = "okay";
};
&i2c0 {
	status = "okay";

	oled@3c {
		compatible = "wukong,ssd1306-fb";
		reg = <0x3c>;
		status = "okay";
	};
};
&emac {
	phy-handle = <&int_mii_phy>;
	phy-mode = "mii";
	allwinner,leds-active-low;
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>;
	status = "okay";
};
&mmc1 {
	vmmc-supply = <&reg_vcc_wifi>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";

	xr819: wifi@1 {
		reg = <1>;
		compatible = "xradio,xr819";
		interrupt-parent = <&pio>;
		interrupts = <6 10 IRQ_TYPE_EDGE_RISING>;
	};
};
&pio {
    red_led_pins: red-led-pins {
        pins = "PA17";
        function = "gpio_out";
        bias-disable;
        drive-stledrength = <20>;
    };
	key_pa6_pins: key_pa6_pins {
		pins = "PA6";
		function = "gpio_in";
		bias-pull-up;
	};
};
